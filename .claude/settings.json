{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/p2m_upload.py*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lean-warm.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
