    ∃ t ≤ powInit.timeBound.eval (2 * b.length + 4 * e + 3) +
        (e + 1) * (powStep.timeBound.eval (4 * e + 2 * b.length ^ e + 2 * b.length + 5) + 1) + 1,
      powProg.Runs (encode (b, e)) (encode (unary (b.length ^ e))) t := by sorry
